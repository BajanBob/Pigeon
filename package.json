{
  "name": "pigeon",
  "version": "1.0.0",
  "description": "Pigeon — geographic location-awareness navigator with encrypted peer-to-peer live location sharing (internet + ham-radio RF).",
  "author": "BajanBob",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "cap:sync": "cap sync",
    "cap:android": "cap add android && cap sync android",
    "cap:ios": "cap add ios && cap sync ios",
    "electron": "electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/camera": "6.1.2",
    "@capacitor/core": "6.2.1",
    "@capacitor/geolocation": "6.1.0",
    "@capacitor/ios": "6.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "net.pigeon.nav",
    "productName": "Pigeon",
    "files": [
      "electron/**/*",
      "www/**/*"
    ],
    "directories": {
      "output": "dist-win",
      "buildResources": "resources"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
